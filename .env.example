# =============================================================================
# Information Board configuration
#
# Create your .env with the guided installer:   python3 scripts/setup.py
# or copy this file to .env and replace every CHANGE_ME value.
#
# Reference: docs/configuration.md (English) · docs/es/configuracion.md (Español)
# =============================================================================

# --- Identity ------------------------------------------------------------------
# Initial defaults only: administrators can change them later in Settings > Branding.
APP_NAME=Information Board
ORGANIZATION_NAME=
BRAND_PRIMARY_COLOR=#2563eb
# Interface language for screens and first-time visitors: en | es
DEFAULT_LANGUAGE=en
# BCP 47 locale used for dates, e.g. en-US, en-GB, es-CL. Empty = en-US or es-ES.
DATE_LOCALE=
# IANA time zone for schedules, TV clocks and the containers, e.g. America/Santiago.
TZ=UTC

# --- Network -------------------------------------------------------------------
# Address used in QR codes and share links.
# Empty (recommended) = automatic: links use the same address each TV, phone or computer used to
# open the board, so moving the server to another IP address or network needs no change here.
# Set it only to force one address, e.g. behind an HTTPS reverse proxy: https://board.example.org
PUBLIC_BASE_URL=
HTTP_PORT=80
# Optional networks allowed to use the admin API, comma-separated. "private" allows every private
# network (10.x, 172.16-31.x, 192.168.x, VPNs, localhost) and keeps working when the LAN changes;
# specific subnets such as 192.168.1.0/24 are also accepted. Empty = no restriction.
# Screens, QR pages and the health check stay reachable from anywhere.
ALLOWED_NETWORKS=
# Extra browser origins allowed to call the API (only needed for custom integrations).
CORS_EXTRA_ORIGINS=

# --- First administrator and screens -------------------------------------------
# Only used while the database is empty. Changing them later does not modify existing
# accounts; use "docker compose exec backend python -m app.cli reset-password" instead.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_ADMIN_PASSWORD
# Screens created on the first start as slug:Name pairs, e.g. lobby:Lobby,hall:Main hall
# Empty = a single "main" screen (or "principal" when DEFAULT_LANGUAGE=es).
INITIAL_SCREENS=

# --- Security --------------------------------------------------------------------
# In production the backend refuses to start while placeholder secrets remain.
APP_ENV=production
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Minutes an admin session lasts.
ACCESS_TOKEN_MINUTES=480
# Failed sign-in attempts allowed per IP address within the window below.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# --- Database and cache ------------------------------------------------------------
POSTGRES_DB=information_board
POSTGRES_USER=information_board
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
# Must contain the same user and password as above.
DATABASE_URL=postgresql+psycopg://information_board:CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD@postgres:5432/information_board
REDIS_URL=redis://redis:6379/0

# --- Publications ----------------------------------------------------------------
# Initial default length of new publications in days (0 = no end date). Editable later in
# Settings > Screens & TV, and each publication can set its own start, end and weekdays.
DEFAULT_PUBLICATION_DAYS=7
# Calendar address (ICS) pre-filled when someone creates a Calendar publication, so each
# installation points at its own calendar. Publish the calendar in Outlook, Google or
# Nextcloud and paste the link ending in .ics; empty = type the address every time.
# Example shape: https://outlook.office365.com/owa/calendar/<id>/<key>/calendar.ics
DEFAULT_CALENDAR_ICS_URL=

# --- Uploads -----------------------------------------------------------------------
MAX_DOCUMENT_SIZE_MB=100
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=500
MAX_LOGO_SIZE_MB=5
# Largest request nginx accepts. Keep it above the biggest limit above.
NGINX_MAX_BODY_SIZE=600m

# --- File storage (docs/storage.md) --------------------------------------------------
# local = a folder on this server, which can itself be a NAS mounted on the host.
# s3    = S3-compatible object storage on the network or the Internet.
STORAGE_BACKEND=local
# Folders for uploaded files and backups on the Docker host (local backend).
BOARD_DATA_PATH=./data
BOARD_BACKUPS_PATH=./backups
# Owner uid/gid of those folders: the containers run as this non-root user.
APP_UID=1000
APP_GID=1000
# Number of backups scripts/backup.sh keeps (0 = keep all).
BACKUP_KEEP=0

# NAS mounted directly by Docker. Enable one override file, for example:
#   COMPOSE_PATH_SEPARATOR=:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.nas-smb.yml
NAS_HOST=
NAS_SHARE=
NAS_USERNAME=
NAS_PASSWORD=
NAS_SMB_VERSION=3.0
NAS_NFS_EXPORT=

# S3-compatible storage (STORAGE_BACKEND=s3): AWS S3, Cloudflare R2, Backblaze B2,
# Wasabi, MinIO, Garage, SeaweedFS...
S3_BUCKET=
S3_REGION=
# Empty for AWS; the provider's endpoint otherwise, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional folder inside the bucket, so several installations can share one bucket.
S3_PREFIX=
# true for most self-hosted servers (MinIO, Garage, SeaweedFS).
S3_FORCE_PATH_STYLE=false
# proxy    = files flow through this server (works when screens have no Internet access)
# redirect = browsers download straight from the bucket through short-lived signed links
S3_SERVE_MODE=proxy
S3_PRESIGN_SECONDS=3600

# --- Featured event address geocoding -----------------------------------------------
GEOCODING_ENABLED=true
# Any Nominatim-compatible search endpoint (e.g. a self-hosted instance).
GEOCODE_URL=https://nominatim.openstreetmap.org/search
# Comma-separated ISO country codes that restrict results, e.g. cl or us,ca. Empty = worldwide.
GEOCODE_COUNTRY_CODES=
# Identify your installation to the geocoding service (required by OpenStreetMap's policy).
GEOCODE_USER_AGENT=
